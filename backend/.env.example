APP_NAME=Reach API
APP_VERSION=1.0.0
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
DATA_DIR=data
HTTP_TIMEOUT_SECONDS=20
CACHE_TTL_SECONDS=1800
MAX_UPLOAD_MB=10
SECTIVIA_DATASET_URL=https://sectivia.com/dataset/sectivia-supply-chain.json
SECTIVIA_COMPANIES_CSV_URL=https://sectivia.com/dataset/sectivia-companies.csv
SECTIVIA_RELATIONS_CSV_URL=https://sectivia.com/dataset/sectivia-relations.csv
SECTIVIA_LOCAL_JSON_PATH=data/sectivia/sectivia-supply-chain.json
SECTIVIA_AUTO_REFRESH=true
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_HOURLY=temperature_2m,relative_humidity_2m,precipitation,precipitation_probability,wind_speed_10m,wind_gusts_10m
OPEN_METEO_DAILY=temperature_2m_max,temperature_2m_min,precipitation_sum,precipitation_probability_max,wind_speed_10m_max
OPEN_METEO_FORECAST_DAYS=7
CCKP_API_BASE_URL=https://cckpapi.worldbank.org/cckp/v1
CCKP_DEFAULT_QUERY_PATH=cmip6-x0.25_climatology_tas,tasmin,tasmax_climatology_annual_1995-2014_median_historical_ensemble_all_mean
CCKP_DEFAULT_GEOCODE=IND
CCKP_ENABLED=true
QUANTIFY_ENABLED=false
QUANTIFY_API_BASE_URL=
QUANTIFY_API_PATH=/
QUANTIFY_API_KEY=
QUANTIFY_API_KEY_HEADER=Authorization
QUANTIFY_API_KEY_PREFIX=Bearer
QUANTIFY_TIMEOUT_SECONDS=15
SCENARIO_DEFAULT_SHOCK_PCT=5.0
SCENARIO_SEVERE_SHOCK_PCT=15.0
